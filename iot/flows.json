    {
        "id": "7e6b8fd1022ece91",
        "type": "function",
        "z": "396b35923faa02eb",
        "name": "InfluxDB",
        "func": "// Verifica conversão\nif (typeof msg.payload === 'string') {\n    try { msg.payload = JSON.parse(msg.payload); }\n    catch (e) { return null; }\n}\n\nif (!msg.payload || msg.payload.temperatura === undefined) { return null; }\n\n// Estruturação em array para node-red-contrib-influxdb\nmsg.payload = [\n    {\n        temperatura: msg.payload.temperatura,\n        umidade_ar: msg.payload.umidade_ar,\n        umidade_solo: msg.payload.umidade_solo,\n        luminosidade: msg.payload.luminosidade\n    },\n    {\n        dispositivo: \"esp32_wokwi\",\n        setor: \"estufa_alfa\"\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
